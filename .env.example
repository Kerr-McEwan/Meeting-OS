# Copy to .env.local and fill in.
# Get these from your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by the sign-in flow to enforce the email-domain allowlist.
# Never commit this and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of permitted email domains (no @).
ALLOWED_EMAIL_DOMAINS=msquared.co.uk,ebsconstruction.co.uk

# The public URL of the deployed app. Used for the magic-link redirect.
# In local dev this is http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
